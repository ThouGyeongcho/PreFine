# Container image, persistent host directory, and runtime ownership.
PREFINE_VERSION=latest
PREFINE_DATA_DIR=./data
PUID=1000
PGID=1000

# Required administrator credentials. These sentinels intentionally prevent startup.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
SESSION_SECRET=CHANGE_ME_SESSION_SECRET

# Browser/session and runtime settings.
COOKIE_SECURE=false
TRUSTED_PROXY_IPS=
TZ=Asia/Shanghai

# Optional reminder email settings. Leave all empty to keep email disabled.
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
REMINDER_TO_EMAIL=
SMTP_USE_TLS=false
SMTP_STARTTLS=false
