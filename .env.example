# Required administrator credentials. Replace every example value before startup.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-random-password
SESSION_SECRET=replace-with-at-least-32-random-characters

# Browser/session and runtime settings.
COOKIE_SECURE=false
TZ=Asia/Shanghai

# Optional reminder email settings. Leave all empty to keep email disabled.
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
REMINDER_TO_EMAIL=
SMTP_USE_TLS=false
SMTP_STARTTLS=false
